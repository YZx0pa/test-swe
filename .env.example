# Copy to .env and fill in.  .env is gitignored — never commit real secrets.

# --- VIRA backend (read by recruiter_cli.py, --mode real) -------------------
# https:// is required; plain http:// only to localhost / 127.0.0.1 / ::1.
# Redirects are never followed, and proxy variables (HTTPS_PROXY, .netrc,
# REQUESTS_CA_BUNDLE) are ignored for VIRA calls.
VIRA_BASE_URL=http://localhost:8080/v1
VIRA_API_KEY=
VIRA_CLIENT_NAME=
VIRA_USER_ID=
# optional: CA bundle for a VIRA behind a private CA (path to a PEM file)
VIRA_CA_BUNDLE=

# --- VIRA engine: Jeni's task groups (jeni_tools, --mode real) --------------
# The task-group endpoint: its full https:// URL, or a path under VIRA_BASE_URL.
VIRA_ACTUAL_LOCATION=https://vira.example.invalid/path/to/task-group
# The xrtoken of the user the tasks run as (sent only to VIRA_ACTUAL_LOCATION, as `xrtoken`).
# Every task group runs with that user's rights, in that user's company.
VIRA_XRTOKEN=

# Where recruiter_cli._audit() appends its JSONL audit trail
EVENTS_LOG=events.jsonl

# --- agent runner (read by run_mini.py) -------------------------------------
# real -> recruiter_cli hits VIRA;  mock -> recruiter_cli hits mock_vira.MockVira
JENI_MODE=mock

# any litellm-supported model id, e.g. gpt-5-mini, anthropic/claude-sonnet-4-5-20250929
CHAT_MODEL=gpt-5-mini

# small model that turns an approval reply in words into edited args (agent_kit.ask_human)
CONFIRM_MODEL=gpt-4o-mini
# 0 silences that model's diagnostics
JENI_DEBUG=1

# credentials for whichever provider CHAT_MODEL points at
OPENAI_API_KEY=

# --- Personal data (pii_vault.py) -------------------------------------------
# The signed-in user's email, for "me" ("share it with me"); the host sets it, never the model.
JENI_USER_EMAIL=
# Optional: 32 random bytes, base64, so email tokens outlive a restart. Unset: a new key per process.
JENI_PII_KEY=

# --- Jeni's task catalog (read by jeni_tools.py, --tools jeni) --------------
# Internal file, shared outside git; see config/README.md.  Default below.
JENI_TASKS_FILE=config/jeni_tasks.json

# --- Jeni's database (read by run_langgraph.py: --tools jeni_db, --mode real) --
# asyncpg DSN; mock mode ignores it.  Through a local tunnel, e.g.
# postgres://USER:PASSWORD@127.0.0.1:5070/DBNAME
TRON_POSTGRES_DSN=
